# Credentials and per-install config: only the example is tracked.
conf/*.ini
!conf/*.example.ini
# Other domains this app serves: each one's own config (secrets) and data (clitool --host-add).
conf/hosts/
/hosts/
# Data this app writes at runtime.
database/*.db
database/*.sqlite
data/*
!data/.gitkeep
secure/
log/*
!log/.gitkeep
cache/*
!cache/.gitkeep
public/uploads/
/uploads/
/.release
# Dependencies (composer.lock IS tracked: an app pins the exact runtime release it runs).
vendor/
# Local tooling.
.mcp.json
.DS_Store
# The builder: task worktrees, the agent's own home and credentials.
.aibuilder/
# The app's own agent binary (a link, machine-local).
/bin/claude
