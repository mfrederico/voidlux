#!/usr/bin/env bash
# Soak this game and print the report. usage: soak [game-seconds] [speed] (defaults 60 4). Run from the game's folder.
# If a producer has the game's page open in the forge, their browser runs the playtest (the forge hands it the request
# written to .studio/ here and the report comes back the same way); otherwise the server's headless Chrome runs it.
set -euo pipefail
SECS=${1:-60}; FAST=${2:-4}
# a game that declares soak_min in game.json (its first night, its first boss) is never soaked for less
MIN=$(python3 -c "import json; print(int(json.load(open('game.json')).get('soak_min', 0)))" 2>/dev/null || echo 0)
if [ "${MIN:-0}" -gt "$SECS" ]; then echo "soak: $SECS s is shorter than this game's soak_min, so it runs for $MIN s" >&2; SECS=$MIN; fi
SLUG=${VOIDLUX_GAME:-$(basename "$PWD")}
STUDIO=${STUDIO:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}
URL=${GAME_URL:-https://voidlux.com/games/$SLUG/}
mkdir -p .studio/soaks
SEEN=.studio/browser-seen; WINDOW=${BROWSER_SOAK_WINDOW:-20}; WAIT=${BROWSER_SOAK_WAIT:-60}
ID="$(date +%Y%m%d-%H%M%S)-$(head -c 2 /dev/urandom | od -An -tx1 | tr -d ' \n' | cut -c1-3)"
printf '{"id":"%s","secs":%d,"fast":%d,"t":%d,"claimed":0}\n' "$ID" "$SECS" "$FAST" "$(date +%s)" > .studio/soak-request.json.tmp && mv .studio/soak-request.json.tmp .studio/soak-request.json
echo "soak: asking a producer's browser (request $ID)…" >&2
DEADLINE=$(( $(date +%s) + SECS / FAST * 5 / 2 + 90 )); CLAIM_BY=$(( $(date +%s) + WAIT ))
while [ "$(date +%s)" -lt "$DEADLINE" ]; do
  if [ -f ".studio/soaks/$ID.json" ]; then python3 -c "import json; r=json.load(open('.studio/soaks/$ID.json')); r.pop('shot',None); print(json.dumps(r, indent=1))"; exit 0; fi
  [ -f .studio/soak-request.json ] || break
  if [ "$(date +%s)" -gt "$CLAIM_BY" ] && grep -q '"claimed":0' .studio/soak-request.json 2>/dev/null; then break; fi
  sleep 1
done
rm -f .studio/soak-request.json
if [ "${SERVER_CHROME:-0}" = "1" ]; then
  ID=$(date +%Y%m%d-%H%M%S)
  PLAYWRIGHT_ROOT=${PLAYWRIGHT_ROOT:-/home/ubuntu} CHROME=${CHROME:-/usr/bin/google-chrome} CDP_URL=${CDP_URL:-http://127.0.0.1:9222} node "$STUDIO/soak.mjs" "$URL" "$SECS" "$FAST" ".studio/soaks/$ID.png" | tee ".studio/soaks/$ID.json" | python3 -c "import json,sys; r=json.loads(sys.stdin.read().strip().splitlines()[-1]); r.pop('notes',None); r.pop('url',None); print(json.dumps(r, indent=1))" || true
  exit 0
fi
# No browser answered and the server's own Chrome is off (it brought this machine down): say so plainly. This is not a
# fault in the game; a producer opens the game's page in the forge and the next soak runs there.
printf '{"ok": false, "status": "no-browser", "runner": "none", "errors": [], "checks": [], "scenes": {}, "note": "no browser is attached to this game, so the playtest could not run. Not a fault in the game. Do NOT start a browser yourself: there is none in the jail and the server must never run one. Carry on with the task and say in your reply that the soak is still to be run; it runs in the browser of a producer who opens the game page."}\n'
exit 2
